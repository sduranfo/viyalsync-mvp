{
  "firestore": {
    "database": "(default)",
    "location": "southamerica-east1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
  "public": "dashboard-web/dist",
  "ignore": [
    "firebase.json",
    "**/.*",
    "**/node_modules/**"
  ],
  "rewrites": [
    {
      "source": "**",
      "destination": "/index.html"
    }
  ]
},
  "emulators": {
  "functions": { 
    "port": 5001,
    "host": "0.0.0.0"
  },
  "firestore": { 
    "port": 8080,
    "host": "0.0.0.0"
  },
  "hosting": { 
    "port": 5000,
    "host": "0.0.0.0"
  },
  "ui": { 
    "enabled": true,
    "host": "0.0.0.0",
    "port": 4000
  },
  "singleProjectMode": true
}
}
