rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Pacientes (datos médicos anonimizados) - lectura abierta para el dashboard
    match /pacientes/{pacienteId} {
      allow read: if true;
      allow write: if false; // solo el backend puede escribir
    }
    
    // PII: SOLO Cloud Functions pueden leer y escribir. Nadie más.
    match /pacientes_pii/{pacienteId} {
      allow read, write: if false;
    }
    
    // Cola HIS: solo Cloud Functions
    match /cola_his/{docId} {
      allow read, write: if false;
    }
    
    // Alertas SMS: solo Cloud Functions
    match /alertas_sms/{docId} {
      allow read, write: if false;
    }
  }
}